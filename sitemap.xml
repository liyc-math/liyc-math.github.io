{% assign records = site.pages | where: 'paper_record', true %}{% for r in records %}{% if r.kind != 'journal' and r.kind != 'arxiv' %}{% if r.layout == 'paper' %}<url><loc>https://liyc-math.github.io{{ r.url | xml_escape }}</loc><lastmod>{{ r.release_date | date: '%Y-%m-%d' }}</lastmod></url>{% endif %}{% assign pdf_path = '/papers/' | append: r.paper_id | append: '/v' | append: r.version_number | append: '/paper.pdf' %}{% assign f = site.static_files | where: 'path', pdf_path | first %}{% if f %}<url><loc>https://liyc-math.github.io{{ pdf_path | xml_escape }}</loc></url>{% endif %}{% endif %}{% endfor %}
</urlset>
